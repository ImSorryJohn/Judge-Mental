  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":8.916992,\"yPos\":1320.85059},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Listen\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-246.248535,\"yPos\":2035.6748},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Review
    Footage\",\"parentUIDs\":[99,147],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":803.0581,\"yPos\":2266.86133},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ask
    Questions \",\"parentUIDs\":[147,177,193],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-364.2495,\"yPos\":2503.19531},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Judge\\n\",\"parentUIDs\":[194],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-467.42334,\"yPos\":2935.86548},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Death\",\"parentUIDs\":[25],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":40}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":930.7285,\"yPos\":2504.85742},\"ID\":37,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Those
    people had families! Why did you do it?\",\"parentUIDs\":[36],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":45}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1279.05371,\"yPos\":2588.51953},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wait!
    You used a fork, not a spoon. Why?\",\"parentUIDs\":[36],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":47}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1614.38232,\"yPos\":2698.198},\"ID\":39,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Since
    when do dogs like ice cream?\",\"parentUIDs\":[46],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":52}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1766.01074,\"yPos\":2246.51172},\"ID\":51,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Romance\",\"parentUIDs\":[158,261],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":418.7151,\"yPos\":2329.05859},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    free after this?\",\"parentUIDs\":[52],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":111}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":631.070557,\"yPos\":2452.02051},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    are your hobbies? It's important for the case\",\"parentUIDs\":[52],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":400.746826,\"yPos\":3073.54419},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Stilll.
    Wanna hang out?\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":274.750244,\"yPos\":3273.21655},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    can give you whatever you want!\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":101}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":712.0669,\"yPos\":3398.89429},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Look
    suggestively\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":67}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":315.416016,\"yPos\":3588.535},\"ID\":66,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Flirt
    more\",\"parentUIDs\":[65],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":443.08252,\"yPos\":4251.12},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By
    the way, did you do it? I like the bad boys.\",\"parentUIDs\":[71],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":52.7492676,\"yPos\":4428.729},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Has
    anyone ever told you your eyes look like moss?\\r\",\"parentUIDs\":[74,103,113,129],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":161}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1063.56226,\"yPos\":6078.172},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Surprise!
    I tricked you!\",\"parentUIDs\":[74],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":656.239258,\"yPos\":4612.22363},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Talk
    dirty\",\"parentUIDs\":[77],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":208}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":648.570557,\"yPos\":5103.37158},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Maybe
    not to jail... But what about home arrest at my place?\",\"parentUIDs\":[82],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":224.919922,\"yPos\":5879.397},\"ID\":92,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Take
